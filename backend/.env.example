# Tusk.ai Backend Configuration (Placeholders only - copy to .env for local development)
TUSK_ENV=development
TUSK_HOST=0.0.0.0
TUSK_PORT=8000
TUSK_DB_PATH=data/tusk.db
TUSK_ARTIFACTS_DIR=data/artifacts
TUSK_CORS_ORIGINS=["*"]
TUSK_LOG_LEVEL=INFO
TUSK_GEMINI_MODEL=gemini-3-flash-preview
# Note: gemini-3.5-flash hits daily free-tier quota limits (HTTP 429 with ~3h Retry-After).
# Use gemini-3-flash-preview which was confirmed available for this API key.

# JWT Authentication & Identity (Required in production; change secret key)
TUSK_JWT_SECRET="your_secure_random_jwt_secret_key_at_least_32_characters"
TUSK_ACCESS_TOKEN_EXPIRE_MINUTES=30
TUSK_REFRESH_TOKEN_EXPIRE_DAYS=7
TUSK_AUTH_REQUIRED=false

# Google Gemini API Key (keep secret - never commit actual key to git)
GEMINI_API_KEY=your_gemini_api_key_here

# External Agent Interoperability (Fetch.ai uAgents)
TUSK_AGENT_ENABLED=true
TUSK_AGENT_NAME=tusk_action_agent
TUSK_AGENT_PORT=8001
# Optional: Seed for deterministic agent address (leave blank for auto-generation)
# TUSK_AGENT_SEED="f0vHH7Hc0DTp8j5MSAqgma9TTlZVKHOPYlRwgEgD/mY="
# Optional: Public endpoint if hosting externally
# TUSK_AGENT_ENDPOINT="http://127.0.0.1:8001/submit"
